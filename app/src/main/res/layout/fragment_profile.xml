<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvAvatar" android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_circle" android:gravity="center" android:textColor="@color/white" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvName" style="@style/Tienda.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/tvEmail" style="@style/Tienda.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
        <TextView android:id="@+id/tvRole" style="@style/Tienda.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" />
        <TextView style="@style/Tienda.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Datos personales" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Guardar cambios" />
        <TextView style="@style/Tienda.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preferencias" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swNotif" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Notificaciones de pedidos" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swBiometric" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Ingreso con huella" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMyOrders" style="@style/Widget.Tienda.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mis compras" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/Widget.Tienda.Button.Coral" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cerrar sesión" />
    </LinearLayout>
</ScrollView>
