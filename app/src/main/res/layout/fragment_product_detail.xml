<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="240dp" android:background="@drawable/bg_image_placeholder">
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center" android:contentDescription="Foto del producto" android:src="@drawable/ic_box_navy" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tvCategory" style="@style/Tienda.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvName" style="@style/Tienda.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/coral" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvStock" style="@style/Tienda.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
            <TextView style="@style/Tienda.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descripción" />
            <TextView android:id="@+id/tvDesc" style="@style/Tienda.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnMinus" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_badge" android:contentDescription="Menos" android:src="@drawable/ic_minus" />
                <TextView android:id="@+id/tvQty" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="1" android:textColor="@color/navy" android:textSize="20sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/btnPlus" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_badge" android:contentDescription="Más" android:src="@drawable/ic_plus" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Agregar al carrito" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
